# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Selection (default: gemini-3.8-flash)
# Supported options: gemini-3.8-flash, gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-3.8-flash

# ChromaDB Storage Directory
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Embedding Model (Sentence Transformers HuggingFace model)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunking Configurations
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval Configurations
TOP_K=4
